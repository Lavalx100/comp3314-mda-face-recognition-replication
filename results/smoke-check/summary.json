      "repeats": 1,
      "mean_accuracy": 0.709375,
      "std_accuracy": 0.0
    },
    {
      "train_per_class": 2,
      "method": "MDA/2-1",
      "repeats": 1,
      "mean_accuracy": 0.715625,
      "std_accuracy": 0.0
    },
    {
